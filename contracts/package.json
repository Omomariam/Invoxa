{
  "name": "invoxa-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network botchain-testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network botchain-mainnet",
    "verify:testnet": "hardhat verify --network botchain-testnet",
    "verify:mainnet": "hardhat verify --network botchain-mainnet",
    "gas-report": "REPORT_GAS=true hardhat test",
    "preflight:mainnet": "hardhat run scripts/check-deployment.ts --network botchain-mainnet",
    "preflight:testnet": "hardhat run scripts/check-deployment.ts --network botchain-testnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.0",
    "solidity-coverage": "^0.8.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
