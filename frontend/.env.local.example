# Environment example for Invoxa

# Blockchain RPC URLs
NEXT_PUBLIC_BOT_TESTNET_RPC=https://rpc.bohr.life
NEXT_PUBLIC_BOT_MAINNET_RPC=https://rpc.botchain.ai

# Contract Addresses (update after deployment)
NEXT_PUBLIC_INVOICE_CONTRACT_TESTNET=0x
NEXT_PUBLIC_INVOICE_CONTRACT_MAINNET=0x

# Application Settings
NEXT_PUBLIC_APP_NAME=Invoxa
NEXT_PUBLIC_APP_DESCRIPTION=Invoice. Get paid. Prove it.
NEXT_PUBLIC_ENVIRONMENT=development

# ERC4337 Bundler
NEXT_PUBLIC_ERC4337_BUNDLER_TESTNET=https://bundler.bohr.life/rpc
NEXT_PUBLIC_ERC4337_BUNDLER_MAINNET=https://bundler.botchain.ai/rpc

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=

# Select explicitly for each build; production should use mainnet.
NEXT_PUBLIC_BOT_NETWORK=testnet
# Deployment blocks enable bounded event lookup.
NEXT_PUBLIC_DEPLOYMENT_BLOCK_MAINNET=
NEXT_PUBLIC_DEPLOYMENT_BLOCK_TESTNET=
